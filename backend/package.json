{
  "name": "oread-backend",
  "version": "0.2.0",
  "description": "Oread API: lorebook, prompt building, storage, settings and model providers",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:db": "prisma migrate deploy && TEST_DATABASE_URL=\"$DATABASE_URL\" node --test \"test/**/*.test.js\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "import:local": "node scripts/importLocalData.js"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "resend": "6.35.0"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
