# Oread backend environment. Copy to backend/.env for local use (it is git-ignored) or set these
# on the host. With none of the hosted values set, Oread runs in local mode: one person, data in
# backend/data, no login.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4317
HOST=127.0.0.1
# Browser origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Local mode paths (optional) ─────────────────────────────────────────────
# OREAD_DATA=./data
# OREAD_MODEL_CACHE=./models
# OREAD_LORE=./lore/lore.json
# OREAD_STORY_TEMPLATES=./lore/storyTemplates
# OREAD_STORY_ENGINE=./lore/storyEngine.json

# ── Provider keys for local mode only (ignored when hosted) ─────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# GEMINI_API_KEY=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_BEARER_TOKEN_BEDROCK=

# ── Hosted mode: all of these are required together ─────────────────────────
# Postgres (Prisma Postgres), with sslmode=require for a hosted database. The app can use the
# pooled address (pooled.db.prisma.io).
DATABASE_URL=
# Migrations (npm run db:migrate) need the direct address (db.prisma.io); without this line they
# use DATABASE_URL.
DIRECT_DATABASE_URL=
# "true" turns on accounts and per-user data.
OREAD_MULTI_TENANT=false
# Encrypts each user's provider keys: 32 random bytes, base64 (openssl rand -base64 32).
OREAD_SECRET_KEY=
# Signs sessions: a long random string (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# The address people open Oread at; email links point here. Locally that's the Vite dev server,
# which passes /api through to the backend.
OREAD_PUBLIC_URL=http://127.0.0.1:5173
# Resend, for confirmation and password-reset emails, from a verified domain.
RESEND_API_KEY=
OREAD_MAIL_FROM=Oread <hello@example.com>
# Rate limiting on sign-in routes (on unless set to "false").
OREAD_AUTH_RATE_LIMIT=true
