{
  "version": "1.0",
  "description": "Tuning for the story engine. A local emotion model scores each scene with 28 GoEmotions labels; emotionMap turns those into an appraisal; the rest moves mood, stress and plasticity and slowly shifts traits when experiences repeat. Scales: dials -2..2, appraisal fields -1..1 or 0..1.",

  "emotionModel": {
    "id": "SamLowe/roberta-base-go_emotions-onnx",
    "dtype": "q8",
    "neutralLabel": "neutral",
    "maximumNeutralShare": 0.6
  },

  "emotionMap": {
    "fields": {
      "goal_impact": {
        "joy": 1, "gratitude": 1, "love": 1, "excitement": 0.8, "optimism": 0.8, "relief": 0.8,
        "caring": 0.8, "admiration": 0.8, "approval": 0.6, "pride": 0.6, "amusement": 0.6,
        "sadness": -1, "grief": -1, "anger": -1, "disgust": -1, "fear": -1, "disappointment": -0.8,
        "disapproval": -0.8, "annoyance": -0.6, "nervousness": -0.6, "embarrassment": -0.5, "remorse": -0.5
      },
      "novelty": {
        "surprise": 1, "realization": 0.6, "confusion": 0.6, "curiosity": 0.5, "excitement": 0.4
      },
      "control": {
        "pride": 0.6, "approval": 0.5, "optimism": 0.5, "gratitude": 0.3, "joy": 0.3,
        "fear": -1, "nervousness": -0.8, "grief": -0.6, "confusion": -0.5, "embarrassment": -0.5,
        "sadness": -0.4, "anger": -0.4
      },
      "threat": {
        "fear": 1, "anger": 1, "disgust": 0.7, "nervousness": 0.6, "annoyance": 0.5, "disapproval": 0.3
      },
      "safety": {
        "caring": 1, "love": 1, "gratitude": 0.8, "relief": 0.8, "approval": 0.5, "joy": 0.4
      }
    },
    "socialMeanings": {
      "acceptance": { "approval": 1 },
      "rejection": { "disapproval": 0.6, "disappointment": 0.6, "annoyance": 0.4 },
      "kindness": { "caring": 1, "gratitude": 1 },
      "hostility": { "anger": 1, "disgust": 1 },
      "praise": { "admiration": 1, "pride": 0.5 },
      "criticism": { "disapproval": 1, "annoyance": 0.5 },
      "intimacy": { "love": 1, "desire": 0.6 },
      "conflict": { "annoyance": 0.6, "disapproval": 0.4, "anger": 0.4 },
      "abandonment": { "grief": 1, "sadness": 0.6 }
    },
    "socialThreshold": 0.25,
    "topEmotionCount": 3
  },

  "moodImpulse": {
    "p": { "goal_impact": 1.0 },
    "a": { "novelty": 0.6, "threat": 0.8, "safety": -0.4 },
    "d": { "control": 1.0 }
  },

  "moodDynamics": {
    "gainBase": 1.5,
    "gainPerStability": -0.5,
    "decayBase": 0.4,
    "decayPerStability": 0.2
  },

  "stress": {
    "retention": 0.7,
    "perThreat": 0.6,
    "perSafety": 0.5,
    "maximum": 2
  },

  "plasticityShift": {
    "perSafety": 1.0,
    "perThreat": -1.0
  },

  "traitDrift": {
    "sceneWindow": 6,
    "minimumRepeats": 2,
    "stepSize": 0.02,
    "highThreat": 0.5,
    "highSafety": 0.5,
    "socialEffects": {
      "acceptance": { "attach_anxiety": -1, "valence": 0.5 },
      "rejection": { "attach_anxiety": 1, "communion": -0.5 },
      "kindness": { "communion": 1, "attach_avoidance": -0.5 },
      "hostility": { "valence": -1, "reactivity": 1 },
      "praise": { "valence": 1, "agency": 0.5 },
      "criticism": { "valence": -0.5, "attach_anxiety": 0.5 },
      "intimacy": { "attach_avoidance": -1, "communion": 0.5 },
      "conflict": { "agency": 0.5, "reactivity": 0.5 },
      "abandonment": { "attach_anxiety": 1, "attach_avoidance": 0.5 }
    },
    "threatEffects": { "reactivity": 0.5, "valence": -0.5 },
    "safetyEffects": { "reactivity": -0.5, "valence": 0.5 }
  },

  "ledgerLimit": 60,
  "recentSceneCount": 8
}
